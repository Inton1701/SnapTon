<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The approved artwork has roughly 9% transparent/white margin. Expand it by
         14dp per side so the blue tile fills the adaptive icon safe area. -->
    <item
        android:left="-14dp"
        android:top="-14dp"
        android:right="-14dp"
        android:bottom="-14dp">
        <bitmap
            android:src="@drawable/snapton_brand_source"
            android:gravity="fill" />
    </item>
</layer-list>
